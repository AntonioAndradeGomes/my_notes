{
  "name": "mynotes",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "MyNotes — plataforma de notas multiplataforma (API NestJS, Web Next.js, Mobile Flutter)",
  "license": "MIT",
  "packageManager": "pnpm@11.24.0",
  "engines": {
    "node": ">=22.0.0",
    "pnpm": ">=10.0.0"
  },
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "lint:fix": "turbo run lint -- --fix",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "test:e2e": "turbo run test:e2e",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,json,md,yaml,yml}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,jsx,json,md,yaml,yml}\"",
    "clean": "turbo run clean && rm -rf node_modules",
    "docs:lint": "markdownlint-cli2 \"docs/**/*.md\" \"*.md\"",
    "api:validate": "redocly lint mynotes@v1",
    "api:preview": "redocly preview",
    "infra:up": "docker compose --env-file .env -f docker/docker-compose.yml up -d",
    "infra:down": "docker compose --env-file .env -f docker/docker-compose.yml down",
    "infra:reset": "docker compose --env-file .env -f docker/docker-compose.yml down -v && pnpm infra:up",
    "prepare": "husky"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.3",
    "@commitlint/config-conventional": "^21.2.3",
    "@mynotes/eslint-config": "workspace:*",
    "@redocly/cli": "^2.64.1",
    "eslint": "catalog:",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.0",
    "markdownlint-cli2": "^0.23.3",
    "prettier": "^3.9.0",
    "turbo": "^2.11.8",
    "typescript": "~6.0.2"
  },
  "lint-staged": {
    "*.{ts,tsx,js,jsx}": [
      "prettier --write",
      "eslint --fix"
    ],
    "*.{json,md,yaml,yml}": [
      "prettier --write"
    ],
    "apps/mobile/**/*.dart": [
      "dart format"
    ]
  }
}
