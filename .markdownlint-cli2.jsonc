{
  "config": {
    "default": true,
    "MD013": false,       // largura de linha livre
    "MD024": { "siblings_only": true },
    "MD033": false,       // HTML inline permitido (badges, detalhes)
    "MD041": false
  },
  "globs": ["docs/**/*.md", "*.md"],
  "ignores": ["node_modules", "**/CHANGELOG.md"]
}
