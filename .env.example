# ------------------------------------------------------------------------------
# MyNotes — variáveis de ambiente (exemplo)
# Copie para `.env` e ajuste. NUNCA versione o `.env`.
# Documentação: docs/guides/environment-variables.md
# ------------------------------------------------------------------------------

# --- Geral --------------------------------------------------------------------
NODE_ENV=development
TZ=America/Sao_Paulo

# --- API (apps/api) -----------------------------------------------------------
API_PORT=3333
API_GLOBAL_PREFIX=api
API_PUBLIC_URL=http://localhost:3333
CORS_ORIGINS=http://localhost:3000

# --- Banco de dados -----------------------------------------------------------
POSTGRES_USER=mynotes
POSTGRES_PASSWORD=mynotes
POSTGRES_DB=mynotes
POSTGRES_PORT=5432
DATABASE_URL=postgresql://mynotes:mynotes@localhost:5432/mynotes?schema=public

# --- Redis (cache, rate limit, blacklist de refresh tokens) --------------------
REDIS_URL=redis://localhost:6379

# --- Autenticação -------------------------------------------------------------
# Gere segredos com: openssl rand -base64 48
JWT_ACCESS_SECRET=troque-me-em-producao
JWT_ACCESS_TTL=15m
JWT_REFRESH_SECRET=troque-me-tambem
JWT_REFRESH_TTL=30d
ARGON2_MEMORY_COST=19456
ARGON2_TIME_COST=2

# --- Armazenamento de anexos (S3 compatível — MinIO em dev) -------------------
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=mynotes-attachments
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_FORCE_PATH_STYLE=true

# --- E-mail (MailDev em dev) --------------------------------------------------
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_FROM="MyNotes <nao-responda@mynotes.local>"

# --- Observabilidade ----------------------------------------------------------
LOG_LEVEL=debug
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
OTEL_SERVICE_NAME=mynotes-api
SENTRY_DSN=

# --- Web (apps/web) — prefixo NEXT_PUBLIC_ é exposto ao browser ---------------
NEXT_PUBLIC_API_URL=http://localhost:3333/api/v1
NEXT_PUBLIC_APP_NAME=MyNotes

# --- Mobile (apps/mobile) — injetadas via --dart-define ----------------------
# flutter run --dart-define=API_URL=http://10.0.2.2:3333/api/v1
